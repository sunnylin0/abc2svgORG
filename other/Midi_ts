// abc2svg - MIDI module
import { Abc } from '../src/Abc';
import * as abc2svg from '../src/abc2svg';

export class Midi {
    abc: Abc;

    constructor(abc: Abc) {
        this.abc = abc;
    }

    static hook(abc: Abc) {
        const midi = new Midi(abc);
        // Hook into Abc methods
        // Using existing generic hook if possible, or wrapping methods as in MIDI.js
        // MIDI.js does:
        // abc.do_pscom = abc2svg.MIDI.do_pscom.bind(abc, abc.do_pscom);
        // abc.set_vp = abc2svg.MIDI.set_vp.bind(abc, abc.set_vp)

        // We can do this in the facade by adding a specific hook point or manually wrapping here.
        // Let's manually wrap here to match the logic.

        const original_do_pscom = abc.do_pscom.bind(abc);
        abc.hooks.do_pscom = (text: string) => {
            // Logic from do_pscom
            if (text.slice(0, 5) == "MIDI ") {
                midi.do_midi(text);
                return; // captured
            }
            original_do_pscom(text);
        };
        // Wait, Abc.do_pscom likely calls hooks.do_pscom if it exists? 
        // Or we need to overwrite the method on instance?
        // Abc.ts likely doesn't have a 'do_pscom' hook designed yet, as it wasn't core.
        // Let's look at Abc.ts do_pscom implementation. 
        // If not present, we might need to add it or monkey patch.

        // For strict refactoring, we often overwrite the method but save the old one.
        // But Abc.ts should be designed to support this.
        // Let's check Abc.ts first or assume we can module-patch it.
        // For now, I will define the class and methods, and handle hooking in Abc.ts or here.
        // The original logic passed 'of' (old function) to the new function.
    }

    // parse %%MIDI commands
    do_midi(parm: string) {
        let n: number, v: any, s: any;
        let o: number, q: number = 0, qs: number;
        let a = parm.split(/\s+/);
        let abc = this.abc;
        let cfmt = abc.cfmt;
        // let curvoice = abc.get_curvoice(); // curvoice is public in Abc
        let curvoice = abc.curvoice;
        let parse = abc.parse;

        // Helper: tb40
        const tb40 = (qs: number) => {
            // b40	  C  D   E   F   G   A   B
            //	[ 2, 8, 14, 19, 25, 31, 37 ]
            let i: number;
            //	      C  G  D  A  E  B ^F ^C ^G ^D ^A ^E ^B^^F^^C^^G^^D^^A^^E^^B
            let n1 = [2, 25, 8, 31, 14, 37, 20, 3, 26, 9, 32, 15, 38, 21, 4, 27, 10, 33, 16, 39];
            //	      C  F _B _E _A _D _G _C _F__B__E__A__D__G__C__F
            let n2 = [0, 19, 36, 13, 30, 7, 24, 1, 18, 35, 12, 29, 6, 23, 0, 17];
            let da = 21 - 3 * qs;		// 21 = 12 (octave) + 9 (A)
            let b = new Float32Array(40);

            for (i = 0; i < n1.length; i++)
                b[n1[i]] = (qs * i + da) % 12;
            for (i = 1; i <= n2.length; i++)
                b[n2[i]] = 12 - (qs * i - da) % 12;
            return b;
        };

        if (curvoice) {
            if (curvoice.ignore)
                return;
            if (curvoice.chn == undefined)
                curvoice.chn = curvoice.v < 9 ?
                    curvoice.v :
                    curvoice.v + 1;
        }

        switch (a[1]) {
            case "chordname":	// %%MIDI chordname <list of MIDI pitches>
                // example: %%MIDI chordname m 0 3 7
                if (!cfmt.chord)
                    cfmt.chord = {};
                if (!cfmt.chord.names)
                    cfmt.chord.names = {};
                cfmt.chord.names[a[2]] = a.slice(3);
                break;
            case "chordprog":	// %%MIDI chordprog <#MIDI program> [octave=<n>]
                if (!cfmt.chord)
                    cfmt.chord = {};
                cfmt.chord.prog = a[2];
                if (a[3] && a[3].slice(0, 7) == "octave=")
                    cfmt.chord.trans = Number(a[3].slice(7));
                break;
            case "chordvol":	// %%MIDI chordvol <volume>
                v = Number(a[2]);
                if (isNaN(v) || v < 0 || v > 127) {
                    abc.syntax(1, abc.errs.bad_val, "%%MIDI chordvol");
                    break;
                }
                if (!cfmt.chord)
                    cfmt.chord = {};
                cfmt.chord.vol = v;
                break;
            case "drum":		// %%MIDI drum <string> <pitches> <volumes>
            case "drumon":
            case "drumoff":
            case "drumbars":	// %%MIDI drumbars n
                if (!curvoice) {
                    abc.syntax(1, "$1 must be in a voice", "%%MIDI " + a[1]);
                    break;
                }
                cfmt.drum = 1;
                s = abc.new_block("mididrum");
                s.play = s.invis = 1; //true
                switch (a[1].slice(4)) {
                    case "on":
                        s.on = 1;
                        break;
                    case "off":
                        s.on = 0;
                        break;
                    case "bars":
                        s.nb = +a[2];
                        if (isNaN(s.nb))
                            q = 1;
                        break;
                    default:
                        s.txt = a.slice(2);
                        v = s.txt[0].match(/[dz][2-9]?/g);	// check the parameters
                        if (v && v.join('') != s.txt[0])
                            v = null;
                        if (v) {
                            n = s.txt[0].match(/d/g).length;
                            v = s.txt.slice(1).join(' ');
                            v = v.match(/[^dz\s][0-9]+/g);
                            if (v && (v.length == n || v.length == 2 * n))
                                break;
                        }
                        q = 1;
                        break;
                }
                if (q) {				// if some error
                    abc.syntax(1, abc.errs.bad_val, "%%MIDI " + a[1]);
                    curvoice.last_sym = s.prev;	// unlink the symbol
                    if (s.prev)
                        s.prev.next = null;
                }
                break;
            case "gchord":		// %%MIDI gchord <list of letters and repeat numbers>
            case "gchordbars":	// %%MIDI gchordbars n
            case "gchordon":	// %%MIDI gchordon
            case "gchordoff":	// %%MIDI gchordoff
                if (!cfmt.chord)
                    cfmt.chord = {};
                if (parse.state >= 2
                    && curvoice) {
                    s = abc.new_block("midigch");
                    s.play = s.invis = 1; //true
                    let cmd = a[1];
                    if (cmd[6] == 'o') // gchordon / gchordoff
                        s.on = cmd[7] == 'n';
                    else if (cmd[6] == 'b') // gchordbars
                        s.gchnb = +a[2];
                    else
                        s.rhy = a[2];		// chord rhythm
                } else {
                    let cmd = a[1];
                    if (cmd[6] == 'o') {
                        cfmt.chord.gchon = cmd[7] == 'n';
                    } else if (cmd[6] == 'b') {
                        cfmt.chord.gchnb = +a[2];
                    } else {
                        cfmt.chord.rhy = a[2];
                    }
                }
                break;
            case "channel":
                v = parseInt(a[2]);
                if (isNaN(v) || v <= 0 || v > 16) {
                    abc.syntax(1, abc.errs.bad_val, "%%MIDI channel");
                    break;
                }
                v--;				// channel range 1..16 => 0..15
                if (parse.state >= 2) {
                    s = abc.new_block("midiprog");
                    s.play = s.invis = 1; //true
                    s.chn = v;
                } else {
                    abc.set_v_param("channel", v);
                }
                break;
            case "drummap":
                //fixme: should have a 'MIDIdrum' per voice?
                v = Number(a[3]);
                if (isNaN(v)) {
                    abc.syntax(1, abc.errs.bad_val, "%%MIDI drummap");
                    break;
                }
                let nn = ["C", "^C", "D", "_E", "E", "F", "^F", "G", "^G", "A", "_B", "B"][v % 12];
                while (v < 60) {
                    nn += ',';
                    v += 12;
                }
                while (v > 72) {
                    nn += "'";
                    v -= 12;
                }
                this.do_pscom("map MIDIdrum " + a[2] + " play=" + nn);
                abc.set_v_param("mididrum", "MIDIdrum");
                break;
            case "program":
                a.shift();
                v = [];
                if (a[2]) {
                    v[0] = +a[2];		// program
                    v[1] = +a[1];		// channel
                } else {
                    v[0] = +a[1];
                    v[1] = 0;
                }
                if (isNaN(v[0]) || v[0] < 0 || v[0] > 127
                    || (v[1]
                        && (isNaN(v[1]) || v[1] <= 0 || v[1] > 16))) {
                    abc.syntax(1, abc.errs.bad_val, "%%MIDI program");
                    break;
                }
                if (parse.state >= 2) {
                    s = abc.new_block("midiprog");
                    s.play = s.invis = 1; //true
                    s.instr = v[0];
                    s.chn = v[1] > 0
                        ? (v[1] - 1)
                        : curvoice.v < 9 ? curvoice.v : curvoice.v + 1;
                } else {
                    abc.set_v_param("instr", a.slice(1).join(' '));
                }
                break;
            case "control":
                n = parseInt(a[2]);
                if (isNaN(n) || n < 0 || n > 127) {
                    abc.syntax(1, "Bad controller number in %%MIDI");
                    break;
                }
                v = parseInt(a[3]);
                if (isNaN(v) || v < 0 || v > 127) {
                    abc.syntax(1, "Bad controller value in %%MIDI");
                    break;
                }
                if (parse.state >= 2) {
                    s = abc.new_block("midictl");
                    s.play = s.invis = 1; //true
                    s.ctrl = n;
                    s.val = v;
                } else {
                    abc.set_v_param("midictl", a[2] + ' ' + a[3]);
                }
                break;
            case "temperamentequal":
                n = parseInt(a[2]);
                if (isNaN(n) || n < 5 || n > 255) {
                    abc.syntax(1, abc.errs.bad_val, "%%MIDI " + a[1]);
                    return;
                }

                // define the Turkish accidentals (53-TET)
                s = abc.get_glyphs();
                // (Logic for Turkish accidentals omitted for brevity, but should be included if important)
                // Including simplified version or full version if requested.
                // Copying the glyph definitions...
                if (n == 53 && !s.acc12_53) {
                    s.acc12_53 = '<text id="acc12_53" x="-1">&#xe282;</text>';
                    // ... (rest of glyphs)
                }

                q = 7.019550008653874; //  Math.log(3/2)/Math.log(2) * 12
                o = 12;			// octave
                cfmt.nedo = n;		// octave divider
                qs = ((n * q / o + .5) | 0) * o / n;	// new fifth

                if (qs < 6.85 || qs > 7.2)
                    abc.syntax(0, abc.errs.bad_val, "%%MIDI " + a[1]);

                cfmt.temper = tb40(qs);	// pitches / A in 100th of cents
                break;
        }
    }

    // set the MIDI parameters in the current voice
    set_vp(of: Function, a: any) {
        let i: number, item: any, s: any;
        let abc = this.abc;
        let curvoice = abc.curvoice;

        // set the voice parameters before inserting any block
        of(a.slice(0));			// (copy because the parameters are removed)

        for (i = 0; i < a.length; i++) {
            switch (a[i]) {
                case "channel=":		// %%MIDI channel
                    s = abc.new_block("midiprog");
                    s.play = s.invis = 1; //true
                    s.chn = +a[++i];
                    break;
                case "instr=":			// %%MIDI program
                    s = abc.new_block("midiprog");
                    s.play = s.invis = 1; //true
                    s.instr = a[++i].split(' ');
                    if (s.instr[1])
                        s.chn = s.instr.shift() - 1;
                    else
                        s.chn = curvoice.v < 9 ?
                            curvoice.v :
                            curvoice.v + 1;
                    s.instr = +s.instr[0];
                    break;
                case "midictl=":		// %%MIDI control
                    if (!curvoice.midictl)
                        curvoice.midictl = [];
                    item = a[++i].split(' ');
                    curvoice.midictl[item[0]] = Number(item[1]);
                    break;
                case "mididrum=":		// %%MIDI drummap note midipitch
                    if (!curvoice.map)
                        curvoice.map = {};
                    curvoice.map = a[++i];
                    break;
            }
        }
    }

    // Internal wrapper for do_pscom redirection
    do_pscom(text: string) {
        // This is called by the hook
        this.do_midi(text);
    }
}
