{
    "compilerOptions": {
        "target": "es5",
        "module": "commonjs",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "rootDir": "./src",
        "noImplicitAny": false,
        "lib": [
            "dom",
            "es2015",
            "es2016"
        ]
    },
    "include": [
        "src/**/*.ts",
        "other/Jianpu.ts",
        "other/Midi.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}